{
  "name": "@anjuna/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and V1 golden fixtures for every wire contract in Anjuna (drain, LeadsRpc, runtime config, postback, template).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": ["src", "fixtures", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

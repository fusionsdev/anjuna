{
  "name": "anjuna-web",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "6cb8500c35210800451bd9a535482850",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.aduplift.ai", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "AUTH", "database_name": "anjuna-auth", "database_id": "<AUTH_D1_ID>", "migrations_dir": "../../packages/auth-db/migrations" },
    { "binding": "FACTORY", "database_name": "anjuna-factory", "database_id": "<FACTORY_D1_ID>", "migrations_dir": "../../packages/factory-db/migrations" }
  ],
  // CORE service binding is added when T6 deploys anjuna-core:
  //   "services": [{ "binding": "CORE", "service": "anjuna-core" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "aduplift.cloudflareaccess.com",
    "ACCESS_AUD": "644bf3613e70f100e38474630d140e3702243de4b9d730eac29262de429120b1",
    "BETTER_AUTH_URL": "https://app.aduplift.ai",
    "MOCK_CORE": "1"
  }
  // Secret (wrangler secret put): BETTER_AUTH_SECRET
  // MOCK_CORE=1 serves the admin API from fixtures until core (T6) exists; remove it to use CORE.
  // DEV_ACCESS_BYPASS must never appear here; use .dev.vars for local work.
}

{
  "name": "anjuna-web",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "6cb8500c35210800451bd9a535482850",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.aduplift.ai", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "AUTH", "database_name": "anjuna-auth", "database_id": "<AUTH_D1_ID>", "migrations_dir": "../../packages/auth-db/migrations" },
    { "binding": "FACTORY", "database_name": "anjuna-factory", "database_id": "<FACTORY_D1_ID>", "migrations_dir": "../../packages/factory-db/migrations" }
  ],
  "services": [
    { "binding": "CORE", "service": "anjuna-core", "entrypoint": "AdminService" },
    { "binding": "CORE_LIFECYCLE", "service": "anjuna-core", "entrypoint": "PanelLifecycleService" },
    { "binding": "FACTORY_WORKER", "service": "anjuna-factory" },
    { "binding": "TEMPLATE_MCP", "service": "anjuna-template-mcp", "entrypoint": "TemplateImportService" }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "anjuna-artifacts" }],
  "vars": {
    "BETTER_AUTH_URL": "https://app.aduplift.ai",
    "MOCK_CORE": "0",
    "DEFAULT_ACCOUNT": "aduplift",
    "DEFAULT_AID": "10001",
    "DEFAULT_PREPOP_BASE": "/apply",
    "DEFAULT_FORM_ROUTE": "/request",
    "DEFAULT_AMOUNT_BUCKETS": "[350,500,750,1000,1500,1750,2000,3000,3250,4500,5000]",
    "DEFAULT_PAYLOAD_VERSION": "2026-01"
  }
  // Secret (wrangler secret put): BETTER_AUTH_SECRET
  // DEV_ACCESS_BYPASS must never appear here; use .dev.vars for local work.
}

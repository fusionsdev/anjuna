{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anjuna-web",
  "main": "src/server/index.ts",
  "account_id": "6cb8500c35210800451bd9a535482850",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "app.aduplift.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "AUTH",
      "database_name": "aduplift-auth",
      "database_id": "b75cb173-0eac-4bd6-8ef2-51a3eb80f230",
      "migrations_dir": "../../packages/auth-db/migrations"
    },
    {
      "binding": "FACTORY",
      "database_name": "aduplift-factory",
      "database_id": "2eb875cb-ae24-4d06-bf15-8df306046980",
      "migrations_dir": "../../packages/factory-db/migrations"
    }
  ],
  "services": [
    {
      "binding": "CORE",
      "service": "anjuna-core",
      "entrypoint": "AdminService"
    },
    {
      "binding": "CORE_LIFECYCLE",
      "service": "anjuna-core",
      "entrypoint": "PanelLifecycleService"
    },
    {
      "binding": "FACTORY_WORKER",
      "service": "anjuna-factory"
    },
    {
      "binding": "TEMPLATE_MCP",
      "service": "anjuna-template-mcp",
      "entrypoint": "TemplateImportService"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "anjuna-artifacts"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://app.aduplift.ai",
    "MOCK_CORE": "0",
    "DEFAULT_ACCOUNT": "aduplift",
    "DEFAULT_AID": "13119",
    "DEFAULT_PREPOP_BASE": "/apply",
    "DEFAULT_FORM_ROUTE": "/request",
    "DEFAULT_AMOUNT_BUCKETS": "[350,500,750,1000,1500,1750,2000,3000,3250,4500,5000]",
    "DEFAULT_PAYLOAD_VERSION": "2026-01"
  }
}

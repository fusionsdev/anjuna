---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root { --ink: #10231c; --accent: #1f7a4d; --bg: #f6faf7; }
      body { margin: 0; font-family: system-ui, sans-serif; color: var(--ink); background: var(--bg); }
      main { max-width: 720px; margin: 0 auto; padding: 48px 20px; }
      h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 16px; }
      form.cta { display: grid; gap: 12px; margin-top: 24px; background: #fff; padding: 20px; border-radius: 12px; }
      select, input, button { font: inherit; padding: 12px; border-radius: 8px; border: 1px solid #c9d6cf; }
      button { background: var(--accent); color: #fff; border: 0; cursor: pointer; }
      footer { font-size: .85rem; margin-top: 48px; }
      footer a { margin-right: 12px; color: var(--ink); }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <footer>
        <a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>
        <p>Spike Brand is not a lender. Requests are shared with lending partners. Not all applicants qualify.</p>
      </footer>
    </main>
  </body>
</html>

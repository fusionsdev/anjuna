{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anjuna-factory",
  "main": "src/index.ts",
  "account_id": "6cb8500c35210800451bd9a535482850",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "FACTORY",
      "database_name": "aduplift-factory",
      "database_id": "2eb875cb-ae24-4d06-bf15-8df306046980",
      "migrations_dir": "../../packages/factory-db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "anjuna-artifacts"
    }
  ],
  "services": [
    {
      "binding": "CORE_LIFECYCLE",
      "service": "anjuna-core",
      "entrypoint": "FactoryLifecycleService"
    }
  ],
  "workflows": [
    {
      "name": "install-brand",
      "binding": "INSTALL_WORKFLOW",
      "class_name": "InstallBrandWorkflow"
    },
    {
      "name": "rollback-brand",
      "binding": "ROLLBACK_WORKFLOW",
      "class_name": "RollbackBrandWorkflow"
    },
    {
      "name": "upgrade-all",
      "binding": "UPGRADE_WORKFLOW",
      "class_name": "UpgradeAllWorkflow"
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "6cb8500c35210800451bd9a535482850",
    "CORE_ACCOUNT": "aduplift",
    "CORE_DOMAIN": "core.aduplift.ai",
    "CORE_SERVICE_NAME": "anjuna-core",
    "DEFAULT_FORM_ROUTE": "/request",
    "DEFAULT_AMOUNT_BUCKETS": "[350,500,750,1000,1500,1750,2000,3000,3250,4500,5000]",
    "LEADSGATE_AID": "10001",
    "LEADSGATE_PREPOP_BASE": "/apply"
  }
}

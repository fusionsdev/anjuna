{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anjuna-core",
  "main": "src/index.ts",
  "account_id": "6cb8500c35210800451bd9a535482850",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "core.aduplift.ai", "custom_domain": true }],
  // Cron Triggers: mailing sync every 5 minutes (CO-7), alerts every 15 minutes (FA-5). Strings must match src/cron.ts.
  "triggers": { "crons": ["*/5 * * * *", "*/15 * * * *"] },
  "vars": { "LIFECYCLE_ACCOUNT": "aduplift" },
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "anjuna-leads",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/leads-db/migrations"
    },
    {
      "binding": "FACTORY",
      "database_name": "anjuna-factory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/factory-db/migrations"
    }
  ],
  // Per brand and kind ceilings for the analytics forward. Keep equal to ANALYTICS_RATE_LIMITS in src/analytics.ts (a test checks it).
  "ratelimits": [
    { "name": "POSTHOG_LIMITER", "namespace_id": "4101", "simple": { "limit": 300, "period": 60 } },
    { "name": "SENTRY_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "TELEMETRY_LIMITER", "namespace_id": "4103", "simple": { "limit": 600, "period": 60 } },
    { "name": "ERRORS_LIMITER", "namespace_id": "4104", "simple": { "limit": 30, "period": 60 } }
  ]
  // Optional secrets for the mailing cron (it skips until all are set): LISTMONK_URL, LISTMONK_USER, LISTMONK_TOKEN,
  // LISTMONK_LIST_MAP (JSON {"<brand_id>": <list id>}).
  // Optional secrets for the analytics forward (ADR-0004): POSTHOG_KEY (+ POSTHOG_HOST, default https://us.i.posthog.com), SENTRY_DSN.
  // Without them core accepts and drops that kind with a 204 and logs analytics_not_configured once per isolate.
  // Required secret: DRAIN_TOKEN. Per-account and per-brand tokens are stored as D1 hashes.
}

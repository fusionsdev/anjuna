{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anjuna-template-mcp",
  "main": "src/index.ts",
  "account_id": "6cb8500c35210800451bd9a535482850",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.aduplift.ai", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "FACTORY",
      "database_name": "aduplift-factory",
      "database_id": "2eb875cb-ae24-4d06-bf15-8df306046980",
      "migrations_dir": "../../packages/factory-db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "anjuna-artifacts"
    }
  ],
  // Browser Rendering for certification screenshots.
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "MCP_OBJECT", "class_name": "TemplateMcp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TemplateMcp"] }],
  "vars": { "RATE_LIMIT_PER_MINUTE": "60", "SIMILARITY_THRESHOLD": "0.5" }
  // Optional secrets: GITHUB_TOKEN (read-only for private repos), OWNER_SECRET (required for seal_template_version).
  // Builder API keys are stored as SHA-256 hashes in the factory D1 (builder_keys); mint with scripts/mint-key.mjs.
}
